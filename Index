<script>
/* CONTACTO: modifica únicamente el número, con prefijo de país y sin espacios. */
const CONTACTO = { whatsapp: '34684275474' };
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
let paused = false;
const motion = document.querySelector('.motion');
function motionBlocked(){return paused || reducedMotion.matches;}
function setMotion(){
  const blocked=motionBlocked();
  document.body.classList.toggle('paused',blocked);
  motion.setAttribute('aria-pressed',String(blocked));
  motion.textContent=reducedMotion.matches?'Movimiento reducido ◷':paused?'Activar animación ▷':'Pausar animación ◷';
  motion.disabled=reducedMotion.matches;
  resetTitleAnimation();
  scheduleTitle();
}
motion.addEventListener('click',()=>{paused=!paused;setMotion();});
reducedMotion.addEventListener('change',setMotion);
const scenes=[['Todo empieza con un «¿y esto?».','Una forma, un movimiento, una idea inesperada. Algo que te invita a quedarte un poco más.'],['Cada pieza tiene algo que contar.','Los mismos elementos, una nueva historia. El contenido cobra sentido cuando encuentra su propia forma.'],['Ahora formas parte de la idea.','Tu gesto ha cambiado lo que ves. Así de sencilla puede ser la diferencia entre mirar y participar.']];
document.querySelectorAll('.channel').forEach(button=>button.addEventListener('click',()=>{const n=Number(button.dataset.scene);document.querySelectorAll('.channel').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelector('.art').dataset.scene=n;document.getElementById('scene-title').textContent=scenes[n][0];document.getElementById('scene-copy').textContent=scenes[n][1];document.querySelector('.display-id').textContent=`0${n+1} / 03`;document.querySelectorAll('.dots i').forEach((dot,i)=>dot.classList.toggle('active',i===n));}));
const letters=[...document.querySelectorAll('.letter')];
const hero=document.querySelector('.hero');
let heroVisible=false, autoTimer=null;
const letterTimers=new Set();
function later(callback,delay){const timer=setTimeout(()=>{letterTimers.delete(timer);callback();},delay);letterTimers.add(timer);}
function resetTitleAnimation(){
  clearTimeout(autoTimer);
  letterTimers.forEach(clearTimeout);letterTimers.clear();
  letters.forEach(letter=>letter.classList.remove('play'));
  document.querySelectorAll('.burst').forEach(piece=>piece.remove());
}
function scheduleTitle(){
  clearTimeout(autoTimer);
  if(motionBlocked() || document.hidden || !heroVisible)return;
  autoTimer=setTimeout(()=>{animateTitle();scheduleTitle();},9000+Math.random()*7000);
}
function animateTitle(){
  if(motionBlocked() || document.hidden)return;
  resetTitleAnimation();
  letters.forEach((letter,i)=>later(()=>{
    if(motionBlocked())return;
    letter.classList.add('play');
    later(()=>letter.classList.remove('play'),480);
  },i*70));
}
function burst(x,y){if(motionBlocked())return;for(let i=0;i<12;i++){const piece=document.createElement('i');piece.className='burst';piece.style.cssText=`left:${x}px;top:${y}px;background:${['#1749e5','#ed403b','#ffcf24'][i%3]};border-radius:${i%2?'50%':'2px'};--x:${Math.cos(i/12*Math.PI*2)*(40+Math.random()*55)}px;--y:${Math.sin(i/12*Math.PI*2)*(40+Math.random()*55)}px`;document.body.appendChild(piece);piece.addEventListener('animationend',()=>piece.remove(),{once:true});setTimeout(()=>piece.remove(),1100);}}
letters.forEach(letter=>letter.addEventListener('pointerdown',event=>{
  if(motionBlocked())return;
  resetTitleAnimation();letter.classList.add('play');burst(event.clientX,event.clientY);
  later(()=>letter.classList.remove('play'),650);scheduleTitle();
}));
document.querySelector('.playword').addEventListener('click',()=>{animateTitle();scheduleTitle();});
if('IntersectionObserver' in window){
  new IntersectionObserver(entries=>{
    heroVisible=entries[0].isIntersecting;
    if(!heroVisible)resetTitleAnimation();
    scheduleTitle();
  },{threshold:0}).observe(document.querySelector('.hero-stage'));
}else{heroVisible=true;}
document.addEventListener('visibilitychange',()=>{resetTitleAnimation();scheduleTitle();});
// Each section gets its own clipped, non-interactive background layer.
document.querySelectorAll('main > section').forEach((section,index)=>{
  const layer=document.createElement('div');layer.className='ambient';layer.setAttribute('aria-hidden','true');
  ['ring','tile','cross','dot'].forEach((kind,i)=>{
    const shape=document.createElement('span');shape.className='ambient-shape '+kind;
    const left=[1.5,96,3,97][i], top=[18,36,73,88][(i+index)%4];
    shape.style.cssText=`--left:${left}%;--top:${top}%;--size:${[14,12,15,6][i]}px;--duration:${8+i*2+index}s;--delay:-${i*3+index}s`;
    layer.appendChild(shape);
  });
  section.prepend(layer);
});
setMotion();
document.getElementById('contact-form').addEventListener('submit',event=>{event.preventDefault();const name=document.getElementById('name').value.trim(),idea=document.getElementById('idea').value.trim();if(!name||!idea){const field=!name?document.getElementById('name'):document.getElementById('idea');field.setCustomValidity('Escribe aquí antes de continuar.');field.reportValidity();field.addEventListener('input',()=>field.setCustomValidity(''),{once:true});return;}const message=`¡Hola, InterAds! Soy ${name}.\n\n${idea}`;window.open(`https://wa.me/${CONTACTO.whatsapp}?text=${encodeURIComponent(message)}`,'_blank','noopener,noreferrer');});
document.querySelector('.direct').href=`https://wa.me/${CONTACTO.whatsapp}`;
document.getElementById('year').textContent=new Date().getFullYear();

const copyStatus=document.querySelector('.copy-status');
async function copyContact(value){
  if(navigator.clipboard && window.isSecureContext){
    try{await navigator.clipboard.writeText(value);return true;}catch(error){}
  }
  const previous=document.activeElement;
  const field=document.createElement('textarea');field.value=value;
  field.setAttribute('readonly','');field.style.cssText='position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px;pointer-events:none';
  document.body.appendChild(field);field.focus();field.select();field.setSelectionRange(0,value.length);
  let copied=false;
  try{copied=document.execCommand('copy');}catch(error){}
  field.remove();if(previous && previous.focus)previous.focus({preventScroll:true});
  return copied;
}
document.querySelectorAll('.copy-contact').forEach(button=>button.addEventListener('click',async()=>{
  button.disabled=true;
  try{
    const copied=await copyContact(button.dataset.copy);
    copyStatus.textContent=copied?(button.dataset.copy.includes('@')?'Email copiado.':'Número de teléfono copiado.'):'No se ha podido copiar. Selecciona el dato y cópialo manualmente: '+button.dataset.copy;
  }finally{button.disabled=false;}
}));
</script>
